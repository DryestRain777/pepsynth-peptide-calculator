# ============================================================
#  Pepsynth Labs — Peptide Calculator
#  Apache config for GoDaddy cPanel shared hosting
#  Place this file in the subdomain document root
#  (e.g. /public_html/calculator/.htaccess)
# ============================================================

# ---------- Force HTTPS ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---------- Default document ----------
DirectoryIndex index.html

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache policy ----------
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML must revalidate so updates go live immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Versioned-ish assets: 7 days (bump ?v= in index.html when you edit)
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"

  # Images and icons rarely change
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---------- Security headers ----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Site is fully self-contained: no external scripts, fonts or XHR.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------- Correct MIME types ----------
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/png .png
  AddType application/xml .xml
</IfModule>

# ---------- Block dotfiles and source leftovers ----------
<FilesMatch "^\.|\.(py|md|txt~|bak|log)$">
  Require all denied
</FilesMatch>

# robots.txt must stay reachable
<Files "robots.txt">
  Require all granted
</Files>
